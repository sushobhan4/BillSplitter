<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_popup_menu"
    android:overScrollMode="ifContentScrolls"
    android:scrollbars="vertical">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <TextView
        android:id="@+id/menuEdit"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_lucide_pencil"
        android:drawablePadding="12dp"
        android:drawableTint="@color/text_secondary"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:text="Edit"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <View
        android:id="@+id/dividerEdit"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <TextView
        android:id="@+id/menuShare"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_share_sheet"
        android:drawablePadding="12dp"
        android:drawableTint="@color/text_secondary"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:text="Export"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <View
        android:id="@+id/dividerShare"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <TextView
        android:id="@+id/menuClone"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_lucide_copy"
        android:drawablePadding="12dp"
        android:drawableTint="@color/text_secondary"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:text="Clone"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <View
        android:id="@+id/dividerClone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <TextView
        android:id="@+id/menuDetails"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_lucide_info"
        android:drawablePadding="12dp"
        android:drawableTint="@color/text_secondary"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:text="Details"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

    <View
        android:id="@+id/dividerDelete"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/card_stroke" />

    <TextView
        android:id="@+id/menuDelete"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:drawableStart="@drawable/ic_lucide_trash_2"
        android:drawablePadding="12dp"
        android:drawableTint="@color/brand_coral"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:singleLine="true"
        android:text="Delete"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

</LinearLayout>
</ScrollView>
